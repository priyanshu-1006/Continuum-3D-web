# Set to your public origin before deploying, for absolute social sharing URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional festival sign-in. Use the Supabase publishable key, not a secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Must match the address in the visitor's browser. Defaults to NEXT_PUBLIC_SITE_URL
# or http://127.0.0.1:3000. Set explicitly for a different local preview port.
# CONTINUUM_AUTH_ORIGIN=http://127.0.0.1:3000
